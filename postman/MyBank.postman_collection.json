            "body": { "mode": "raw", "raw": "{\n  \"accountNumber\": \"1234567890\",\n  \"bankCode\": \"999\",\n  \"amountKobo\": 10000,\n  \"pin\": \"{{pin}}\",\n  \"otpCode\": \"REPLACE_ME\"\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
