# ── Database ─────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/banktest
DB_USER=bankapp
DB_PASS=bankpass

# ── Security & Crypto ────────────────────────────────
# JWT_SECRET must be at least 32 characters long
JWT_SECRET=replace_with_a_very_long_random_secret_key_min_32_chars
OTP_PEPPER=replace_with_a_random_string_for_otp_hashing

# ── Paystack (TEST keys ONLY) ────────────────────────
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_test_key

# ── Business Rules ───────────────────────────────────
TRANSFER_CAP_KOBO=10000000
FEE_KOBO=5000

# ── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── OTP Delivery ─────────────────────────────────────
# 'email' = Brevo; anything else (e.g. console) = codes printed to the
# server console (test mode). Main fails fast at boot if OTP_CHANNEL=email
# and the Brevo variables below are missing.
OTP_CHANNEL=console

# Required only when OTP_CHANNEL=email:
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-verified-sender@example.com

# ── Seeder ───────────────────────────────────────────
# Optional: real email for the "Zainab" seed user (receives real OTPs).
# Leave empty to skip that user entirely.
TEST_REAL_EMAIL=

# ── Provider selection ───────────────────────────────
# 'real' = Paystack HTTP adapter (requires enabled DVA); anything else = mock
PROVIDER=mock