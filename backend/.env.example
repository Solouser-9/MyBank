# PostgreSQL connection settings. Use a JDBC URL for your database.
DB_URL=jdbc:postgresql://localhost:5432/banktest
DB_USER=bankapp
DB_PASS=bankpass

# Secret used to sign JWT access tokens. Use a long, randomly generated value
# (at least 32 characters); do not reuse OTP_PEPPER.
JWT_SECRET=

# Secret added when hashing OTPs and refresh tokens. Keep this private and
# different from JWT_SECRET.
OTP_PEPPER=

# Paystack secret key used to verify webhook signatures. Required even when
# PROVIDER=mock. Use a test key for development; never commit a real key.
PAYSTACK_SECRET_KEY=

# Maximum permitted transfer amount in kobo (10,000,000 kobo = ₦100,000).
TRANSFER_CAP_KOBO=10000000

# External transfer fee in kobo (5,000 kobo = ₦50).
FEE_KOBO=5000

# Allowed browser origin for CORS. Set this to the exact frontend origin.
CORS_ORIGIN=http://localhost:5173

# OTP delivery channel: use "email" for Brevo delivery, or "console" to print
# codes to the backend logs for local testing.
OTP_CHANNEL=console

# Required only when OTP_CHANNEL=email. Brevo API key and verified sender
# email address used to deliver OTP messages.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Payment provider adapter: "mock" for local/demo use or "real" for Paystack.
PROVIDER=mock
